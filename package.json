{
  "name": "circuit-desk",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Desktop project editor for the Novation Circuit Tracks",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p app/tsconfig.json && tsc -p app/tsconfig.electron.json",
    "test": "vitest run",
    "survey": "node tools/card-survey.ts",
    "export": "node tools/export.ts",
    "mcp": "node packages/mcp/src/main.ts",
    "mcp:smoke": "node tools/mcp-smoke.ts",
    "app:build": "vite build --config app/vite.config.ts",
    "app": "npm run app:build && electron app/electron/main.ts",
    "app:smoke": "npm run app:build && electron app/scripts/smoke.ts",
    "app:midi-probe": "npm run app:build && electron app/scripts/midi-probe.ts",
    "app:midi-record": "npm run app:build && electron app/scripts/midi-record.ts",
    "app:device-dump": "electron app/scripts/device-dump.ts",
    "app:device-transfer": "electron app/scripts/device-transfer.ts",
    "app:device-record": "electron app/scripts/device-record.ts",
    "app:device-smoke": "node tools/device-smoke.ts",
    "analyse-recording": "node tools/analyse-recording.ts",
    "compare-midi": "node tools/compare-midi.ts",
    "app:render": "npm run app:build && electron app/scripts/render-preview.ts",
    "app:bundle": "vite build --config app/vite.electron.config.ts",
    "app:dist": "node tools/package-app.ts",
    "app:icon": "electron app/scripts/make-icon.ts",
    "app:shots": "npm run app:build && electron app/scripts/shots.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
