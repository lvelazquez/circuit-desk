+// ---- core-1 stub (Circuit Desk): the stock core-1 program is a copy service. Core 0 appends source
+// addresses to a list at X:$30002.., publishes the end pointer at X:$30000, and waits for core 1 to
+// overwrite each entry with the word at that address in core 1's external X memory. We do the same
+// lazily: the first time core 0 reads an entry it wrote, the entry is replaced by the word its address
+// points to. (A PC hook cannot work: the emulator runs a whole DO loop in one step.) External words come
+// from `C1LOAD addr file` (raw 3-byte big-endian words); addresses not loaded read 0 and are counted.
+struct C1Stub {
+    bool on = false, busy = false; uint64_t served = 0, missed = 0, gets = 0, sets = 0, rearm = 0;
+    std::unordered_map<TWord, TWord> ext; FILE* log = nullptr;
+};
+static C1Stub g_c1;
+static FILE* g_audio = nullptr;
+static Memory* g_c1Mem = nullptr;
+static std::vector<uint8_t> g_c1Served(0x1000, 0);
+static void c1Serve(TWord off) {
+    const size_t i = off - 0x30000; if (g_c1Served[i]) return;
+    g_c1.busy = true;
+    const TWord a = g_c1Mem->get(MemArea_X, off) & 0xffffff; TWord v = 0;
+    auto it = g_c1.ext.find(a);
+    if (it != g_c1.ext.end()) v = it->second; else ++g_c1.missed;
+    if (g_c1.log) fprintf(g_c1.log, "%06x %06x\n", a, v);
+    g_c1Mem->set(MemArea_X, off, v); g_c1Mem->set(MemArea_Y, off, v);   // the shared window is one RAM seen from both buses: core 0 reads results with y:(r5)+
+    g_c1Served[i] = 1; ++g_c1.served;
+    g_c1.busy = false;
+}
+// A read of an entry nobody served yet (core 0 reading before publishing the end pointer).
+static void c1GetHook(TWord off) { if (!g_c1.on || g_c1.busy) return; ++g_c1.gets; c1Serve(off); }
+// A write to an entry re-arms it; a write to the end pointer serves everything queued so far.
+static void c1SetHook(TWord off) {
+    if (!g_c1.on || g_c1.busy) return; ++g_c1.sets;
+    if (off != 0x30000) { if (g_c1Served[off - 0x30000]) ++g_c1.rearm; g_c1Served[off - 0x30000] = 0; return; }
+    TWord end = g_c1Mem->get(MemArea_X, 0x30000) & 0xffffff; if (end > 0x31000) end = 0x31000;
+    for (TWord e = 0x30002; e < end; ++e) c1Serve(e);
+}
